{
  "name": "@lailai0916/ui",
  "version": "0.3.4",
  "description": "Shared React components and design tokens for lailai's websites.",
  "type": "module",
  "license": "MIT",
  "author": "lailai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lailai0916/ui.git"
  },
  "homepage": "https://github.com/lailai0916/ui#readme",
  "bugs": {
    "url": "https://github.com/lailai0916/ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "laikit"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-theme.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src demo tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run build:demo",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@iconify/react": "^6.0.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.7.0",
    "prettier": "3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.1"
  }
}
